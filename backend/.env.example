# Backend Server Configuration (SIH26171)
# =========================================
PORT=3000
BACKEND_API_KEY=sih-secret-key-2026
NODE_ENV=development

# VLM / LLM Reasoning Engine Configuration
# Options:
#   'gemini'    — Google Gemini (gemini-3.6-flash, gemini-3.8-flash)
#   'vllm'      — Local/Self-hosted vLLM server (e.g. Qwen2-VL, Llama-3.2-Vision)
#   'ollama'    — Local Ollama server (e.g. llama3.2-vision, qwen2.5)
#   'openai'    — OpenAI API (gpt-4o, gpt-4o-mini)
#   'anthropic' — Anthropic Claude (claude-3-5-sonnet)
#   'mock'      — On-device deterministic reasoning (zero external dependencies)
VLM_PROVIDER=gemini

# API Key:
#   Gemini:    https://aistudio.google.com/apikey (free tier: 15 RPM)
#   OpenAI:    https://platform.openai.com/api-keys
#   Anthropic: https://console.anthropic.com/settings/keys
#   vLLM/Local: Leave blank or set dummy value
VLM_API_KEY=

# Model name:
#   Gemini:    gemini-3.6-flash
#   vLLM:      Qwen/Qwen2-VL-7B-Instruct, meta-llama/Llama-3.2-11B-Vision-Instruct
#   Ollama:    llama3.2-vision, qwen2.5:7b
#   OpenAI:    gpt-4o-mini
#   Anthropic: claude-3-5-sonnet-20241022
VLM_MODEL=gemini-3.6-flash

# Custom Endpoint (required for vLLM and Ollama, optional for cloud):
#   vLLM:      http://localhost:8000/v1/chat/completions
#   Ollama:    http://localhost:11434/v1/chat/completions
#   Cloud:     Leave blank to use default cloud endpoints
VLM_ENDPOINT=
